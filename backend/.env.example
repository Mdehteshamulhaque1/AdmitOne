# Backend Environment Variables — copy to backend/.env for local development
# In Render: Service → Environment → add each variable (or paste .env)
#
# Production checklist (all REQUIRED on Render):
#   SECRET_KEY=         (generate with  python -c "import secrets; print(secrets.token_urlsafe(50))")
#   DJANGO_ENV=production
#   DJANGO_DEBUG=False
#   DATABASE_URL=       (your Supabase Session Pooler string)
#   ALLOWED_HOSTS=      (your-domain.onrender.com)
#   CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS  (your Vercel frontend URL)
#   EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD / DEFAULT_FROM_EMAIL
#     The app will NOT start in production without working email settings — see
#     the Email section below.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# SECURITY: generate a strong key, e.g.  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-super-secret-key-change-me

# "True" enables debug / local-friendly settings. MUST be "False" in production.
DJANGO_DEBUG=True

# Runtime environment: "development" (default) or "production".
# In production, DATABASE_URL is required — there is no SQLite fallback.
DJANGO_ENV=development

# Comma-separated, no spaces
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# CORS / CSRF for the Vercel frontend (comma-separated)
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL only — no Supabase Auth, Storage, or JS client)
# ---------------------------------------------------------------------------
# From Supabase Dashboard → Project Settings → Database → Connection string
# Select "Session pooler" (or "Direct connection") — PostgreSQL, port 5432.
# Replace the placeholders below with YOUR project values. Never commit this
# file with a real password; keep the trailing ?sslmode=require.
# Example only (no real credentials):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave blank (or delete the line) to use the local SQLite fallback in development.
DATABASE_URL=

# Optional: force TLS mode for Postgres (defaults to "require" in settings.py)
# POSTGRES_SSL_MODE=require

# ---------------------------------------------------------------------------
# Email (SMTP) — required to send the QR pass to visitors on approval.
#
# In DEVELOPMENT the console backend is the default: emails are printed to the
# terminal instead of sent, so nothing is needed locally.
#
# In PRODUCTION the service REFUSES TO BOOT unless email is really configured.
# settings.py raises ImproperlyConfigured if EMAIL_BACKEND is console/locmem/
# filebased/dummy, if EMAIL_HOST is missing, if the credentials are missing, if
# DEFAULT_FROM_EMAIL is malformed, or if a remote host is used without TLS. That
# is deliberate: silently falling back to the console backend meant a production
# deployment could look healthy while every visitor email went nowhere.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# STARTTLS (port 587). Case-insensitive: true/1/yes/on/y/t are all accepted;
# any other value is a configuration ERROR, not a silent False.
EMAIL_USE_TLS=True

# Implicit TLS instead of STARTTLS — use this for port 465 and set
# EMAIL_USE_TLS=False.
# EMAIL_USE_SSL=False

# Per-message SMTP timeout in seconds.
EMAIL_TIMEOUT=30

# For Gmail: use an App Password (Google account → Security → 2-Step
# Verification → App passwords); your normal password will NOT work.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SecureGate <no-reply@securegate.io>
